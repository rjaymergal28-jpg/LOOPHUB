-- SERVER HOPPER LOGIC
----------------------------------------------------
local HOP_INTERVAL = 5
local autoHopEnabled = false

local function get1PlayerServers()
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
    local ok1, res = pcall(function() return game:HttpGet(url) end)
    if not ok1 or not res then return {} end

    local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
    if not ok2 or not data or not data.data then return {} end

    local list = {}
    for _, s in ipairs(data.data) do
        if s.playing == 1 and s.id ~= game.JobId then
            table.insert(list, s)
        end
    end
    return list
end

local function doHop()
    Fluent:Notify({ Title = "Server Hopper", Content = "Searching for 1-player server...", Duration = 3 })
    local servers = get1PlayerServers()
    if #servers == 0 then
        Fluent:Notify({ Title = "Server Hopper", Content = "None found — will retry", Duration = 3 })
        return false
    end
    local pick = servers[math.random(1, #servers)]
    Fluent:Notify({ Title = "Server Hopper", Content = "Joining (" .. pick.playing .. " player)...", Duration = 3 })
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, lp)
    end)
    return true
end

-- Auto hop task background loop
task.spawn(function()
    while true do
        if autoHopEnabled then
            for i = HOP_INTERVAL, 1, -1 do
                if not autoHopEnabled then break end
                task.wait(1)
            end
            if autoHopEnabled then
                doHop()
                task.wait(8)
            end
        else
            task.wait(0.5)
        end
    end
end)

